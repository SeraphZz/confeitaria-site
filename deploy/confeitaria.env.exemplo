# Modelo de /etc/confeitaria.env. Troque os valores; o arquivo real nunca vai para o repositório.
NODE_ENV=production
TRUST_PROXY=1
HOST=127.0.0.1
PORT=3000
DATA_DIR=/var/lib/confeitaria
SITE_URL=https://SEU-DOMINIO

# Senha inicial da confeiteira (só vale na primeira subida; depois troque pelo painel e apague esta linha)
ADMIN_PASSWORD=troque-esta-senha

# E-mail do "esqueci minha senha" (no Gmail, use uma "senha de app")
SMTP_HOST=smtp.gmail.com
SMTP_USER=loja@gmail.com
SMTP_PASS=senha-de-app

# Notificações (opcional; veja "Notificações" no README). O e-mail usa o SMTP acima.
# Canal sem estas variáveis não envia nada, mesmo ligado no painel.
# WhatsApp (API oficial da Meta): token e id do número, do painel da Meta.
#WHATSAPP_TOKEN=
#WHATSAPP_PHONE_ID=
# SMS (Twilio): conta, token e o número remetente.
#SMS_TWILIO_SID=
#SMS_TWILIO_TOKEN=
#SMS_TWILIO_FROM=
