# Modelo de /etc/confeitaria.env. Troque os valores; o arquivo real nunca vai para o repositório.
NODE_ENV=production
TRUST_PROXY=1
HOST=127.0.0.1
PORT=3000
DATA_DIR=/var/lib/confeitaria
SITE_URL=https://SEU-DOMINIO

# Senha inicial da confeiteira (só vale na primeira subida; depois troque pelo painel e apague esta linha)
ADMIN_PASSWORD=troque-esta-senha

# E-mail do "esqueci minha senha" (no Gmail, use uma "senha de app")
SMTP_HOST=smtp.gmail.com
SMTP_USER=loja@gmail.com
SMTP_PASS=senha-de-app
